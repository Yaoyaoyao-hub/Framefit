# FrameFit environment
# Copy to .env and fill in real keys only on the machine that runs the backend.
# Never put provider secrets in frontend variables or in git.

# demo | mixed | real
# demo: deterministic fixtures, always labeled Demo data
# mixed: live detection when the model loads; try-on uses YouCam when YOUCAM_API_KEY is set
# real: live integrations only. Missing keys disable those actions.
FRAMEFIT_MODE=demo

# Required secret for signed image links. Use a long random value in production.
SECRET_KEY=replace-with-a-long-random-string

# sqlite:///./data/framefit.db is fine for one local process.
# On Render, point this at a persistent disk. SQLite is single-instance only.
DATABASE_URL=sqlite:///./data/framefit.db

# local or s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/assets

# S3-compatible storage (production). Required when STORAGE_BACKEND=s3.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_BASE_URL=

# Comma-separated browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public base URL of this API, used only when YOUCAM_INPUT_MODE=public_url.
# YouCam must be able to fetch this host. Leave empty for local file upload mode.
PUBLIC_BASE_URL=

# YouCam. Keys stay on the server.
YOUCAM_API_KEY=
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
# file_upload (default) or public_url
YOUCAM_INPUT_MODE=file_upload
# crop or frame. Product try-on always uses the product image.
YOUCAM_REFERENCE_KIND=crop
YOUCAM_TIMEOUT_SECONDS=180
YOUCAM_POLL_INTERVAL_SECONDS=2

# SerpApi Google Lens. Key stays on the server.
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com

# Detection
YOLO_MODEL=yolov8s-worldv2.pt
YOLO_DEVICE=cpu
YOLO_CONFIDENCE=0.15
YOLO_IMAGE_SIZE=640
YOLO_CONCURRENCY=1
YOLO_CACHE_DIR=./data/models
YOLO_CLASSES=hat,scarf,jacket,coat,shirt,sweater,trousers,skirt,dress,shoe,bag

# Limits. Reaching a limit returns an explanation. Nothing is deleted automatically.
MAX_UPLOAD_BYTES=12000000
MAX_IMAGE_EDGE=8000
MAX_GENERATIONS_PER_SESSION=40
MAX_STORAGE_BYTES=524288000
MAX_JOB_CONCURRENCY=2
RATE_LIMIT_PER_MINUTE=120

# Set to 0 in tests if you drive jobs yourself. Leave 1 for the app.
FRAMEFIT_WORKER=1
PORT=8000
